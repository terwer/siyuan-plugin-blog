{
  "name": "siyuan-plugin-blog",
  "version": "6.6.0",
  "scripts": {
    "dev": "pnpm --filter @terwer/share-pro-app dev",
    "dev:app": "pnpm --filter @terwer/share-pro-app dev",
    "dev:all": "turbo run dev",
    "devApp": "pnpm --filter @terwer/share-pro-app dev",
    "devSiyuan": "pnpm --filter siyuan-blog dev",
    "dev:siyuan": "pnpm --filter siyuan-blog dev",
    "buildArtifacts": "node scripts/run-platform-script.mjs build-artifacts",
    "buildSiyuanArtifacts": "node scripts/run-platform-script.mjs build-siyuan-artifacts",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "node scripts/run-platform-script.mjs scripts/clean",
    "start": "node scripts/run-platform-script.mjs scripts/start-node",
    "buildNodeProvider": "node scripts/run-platform-script.mjs build-node-provider",
    "packageNodeProvider": "node scripts/run-platform-script.mjs package-node-provider",
    "package": "node scripts/run-python.mjs scripts/package.py",
    "syncVersion": "node scripts/run-python.mjs scripts/version.py",
    "parseChangelog": "node scripts/run-python.mjs scripts/parse_changelog.py",
    "prepareRelease": "pnpm syncVersion && pnpm parseChangelog",
    "makeLink": "node ./scripts/make_dev_link.mjs"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
