/*
 * 数据库外观完全由思源原生 base.css 提供。
 * 本文件只保留查看端本地筛选面板、空结果和未知类型回退的布局适配，
 * 不定义数据库标题、标签、工具栏、表格、卡片、看板或日历的视觉样式。
 */

.db-view-filter
  min-width 320px
  max-width calc(100vw - 16px)

.db-view-filter-status
  min-height 18px
  margin 0
  color var(--b3-theme-on-surface-light)
  font-size 12px

.db-view-filter-status:empty
  display none

.db-view-empty,
.db-view-unsupported
  margin 8px 0
  padding 16px
  color var(--b3-theme-on-surface-light)

@media (max-width: 640px)
  .db-view-filter
    min-width 0
    width calc(100vw - 16px)

// 正文与只读属性并排；窄屏使用全宽详情栏。
:root
  --db-record-pane-width clamp(360px, 42vw, 720px)

@media (min-width: 900px)
  html:has(.db-view-detail:popover-open) .content-layout:not(.content-layout--preview)
    box-sizing border-box
    padding-inline-end var(--db-record-pane-width)

.db-view-detail
  position fixed
  inset 0 0 0 auto
  box-sizing border-box
  margin 0
  width var(--db-record-pane-width)
  height 100dvh
  max-width 100vw
  max-height none
  padding 0
  overflow auto
  border 0
  border-inline-start 1px solid var(--b3-border-color)
  background var(--b3-theme-background)
  color var(--b3-theme-on-background)
  font-family var(--b3-font-family)

.db-view-detail-header
  display flex
  gap 4px
  align-items flex-start
  justify-content space-between
  padding 16px 24px 4px

.db-view-detail-header .protyle-db-row__title
  margin 0
  padding 7px 0
  overflow-wrap anywhere
  line-height 1.4

.db-view-detail-header svg
  flex none

.db-view-detail .db-view-detail-close
  flex none
  margin-top 9px
  opacity 1

.db-view-detail-body
  padding 8px 24px 24px

.db-view-detail-database,
.db-view-detail-label
  display flex
  align-items center
  gap 8px
  min-width 0

.db-view-detail-database
  color var(--b3-protyle-inline-blockref-color, var(--b3-theme-primary))
  font-weight 600
  margin-bottom 8px

.db-view-detail-database svg,
.db-view-detail-label svg
  width 16px
  height 16px
  flex none

.db-view-detail-field
  display grid
  grid-template-columns minmax(88px, 31%) minmax(0, 1fr)
  align-items start
  gap 12px
  box-sizing border-box
  min-height 42px
  padding 8px 0

.db-view-detail-label
  color var(--b3-theme-on-surface)

.db-view-detail-value
  margin 0
  min-width 0
  overflow-wrap anywhere

.db-view-detail-value .av__celltext
  white-space pre-wrap

.db-view-detail-value [data-type=block-ref]
  white-space pre-wrap

.db-view-detail-value[data-empty=true]
  color var(--b3-theme-on-surface-light)

.db-view-detail-value .av__cellassetimg
  max-width 100%

.av .av__detail-host
  position relative

.av .av__detail-host:has(> [data-type=copy]) > .av__row-actions
  right 26px

.av :is(.av__row:hover, .av__row:focus-within) .av__detail-host > .av__row-actions,
.av .av__detail-host:focus-within > .av__row-actions
  opacity 1
  pointer-events auto

@media (hover: none)
  .av .av__detail-host > .av__row-actions
    opacity 1
    pointer-events auto

@media (max-width: 899px)
  .db-view-detail
    width 100vw

.db-view-ssr-placeholder
  display flex
  align-items center
  gap 12px
  margin 12px 0
  padding 14px 16px
  border 1px solid var(--b3-border-color, #d9d9d9)
  border-radius 8px
  background var(--b3-theme-surface-lighter, #f7f7f7)
  color var(--b3-theme-on-surface, #333)

.db-view-ssr-placeholder-icon
  display inline-flex
  align-items center
  justify-content center
  width 32px
  height 32px
  border-radius 6px
  background var(--b3-theme-primary-lightest, #eaf2ff)
  color var(--b3-theme-primary, #4285f4)
  font-size 22px
  line-height 1

.db-view-ssr-placeholder-content
  display flex
  flex-direction column
  gap 3px
  min-width 0

.db-view-ssr-placeholder-content strong
  font-size 13px

.db-view-ssr-placeholder-content span
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.db-view-ssr-placeholder-content small
  color var(--b3-theme-on-surface-light, #888)
  font-size 12px

.db-view-toast
  position fixed
  left 50%
  bottom 32px
  z-index 1100
  transform translateX(-50%)
  padding 8px 14px
  border-radius 6px
  background var(--b3-theme-on-surface, #333)
  color var(--b3-theme-background, #fff)
  font-size 13px
  box-shadow 0 4px 16px rgba(0, 0, 0, .18)

.db-view-toast--error
  background var(--b3-theme-error, #d93025)

// 思源宿主隐藏只读工具栏中的筛选入口；分享页筛选仅作用于内存快照。
.protyle-wysiwyg[data-readonly=true] .av .av__views > button.block__icon.av__readonly-filter[data-type=av-filter]
  display inline-flex

// 阅读筛选使用原生菜单控件；按视口约束浮层与分组内联布局。
.db-view-filter-menu,
.db-view-filter-picker
  position fixed
  inset auto
  margin 0
  box-sizing border-box
  max-width calc(100vw - 16px)
  max-height calc(100vh - 16px)
  overflow auto

.db-view-filter-menu
  z-index 1000
  width max-content
  min-width 360px
  padding 8px

.db-view-filter-picker
  z-index 1001
  min-width 150px
  padding 4px

.db-view-filter-heading
  position relative
  display grid
  place-items center
  min-height 36px
  border-bottom 1px solid var(--b3-border-color)

.db-view-filter-heading > button
  position absolute
  left 4px
  display inline-flex
  opacity 1

.db-view-filter-body
  padding-top 6px

.db-view-filter-rule
  display grid
  grid-template-columns 48px minmax(0, 1fr) 28px
  align-items start
  gap 8px
  padding 4px

.db-view-filter-rule > span
  line-height 30px
  text-align center
  color var(--b3-theme-on-surface)

.db-view-filter-controls
  display flex
  flex-wrap wrap
  align-items center
  gap 6px
  min-width 0

.db-view-filter-group
  flex 1 1 100%
  min-width 0
  padding 6px
  border 1px solid var(--b3-border-color)
  border-radius 6px
  background var(--b3-theme-surface)

.db-view-filter-select,
.db-view-filter-choice,
.db-view-filter-remove
  display inline-flex
  align-items center
  gap 6px

.db-view-filter-menu .db-view-filter-remove
  opacity 1

.db-view-filter-choice
  display flex
  text-align start
  min-height 30px

.db-view-filter-select,
.db-view-filter-value-input
  min-height 30px

.db-view-filter-select
  cursor pointer

.db-view-filter-value-input
  flex 1 1 120px
  width 155px
  box-sizing border-box

.db-view-filter-icon
  display inline-flex
  flex none
  color var(--b3-theme-on-surface)

.db-view-filter-icon svg
  width 14px
  height 14px

@media (max-width: 640px)
  .db-view-filter-menu
    min-width 0
    width calc(100vw - 16px)

  .db-view-filter-rule
    grid-template-columns 36px minmax(0, 1fr) 24px
    gap 4px

// 排序复用思源菜单与原生下拉；日期规则的端点与方向独占下一行。
.db-view-sort-menu
  position fixed
  inset auto
  margin 0
  box-sizing border-box
  width 290px
  max-width calc(100vw - 16px)
  max-height calc(100vh - 16px)
  overflow auto
  padding 8px

.db-view-sort-items
  padding-top 4px

.db-view-sort-row
  display grid
  grid-template-columns 22px minmax(0, 1fr) 22px
  align-items start
  gap 6px
  padding 4px
  border-radius 6px

.db-view-sort-row:hover,
.db-view-sort-row:focus-within
  background var(--b3-list-hover)

.db-view-sort-row[data-sort-drop=before]
  box-shadow inset 0 2px var(--b3-theme-primary)

.db-view-sort-row[data-sort-drop=after]
  box-shadow inset 0 -2px var(--b3-theme-primary)

.db-view-sort-controls
  display grid
  grid-template-columns minmax(0, 1fr) auto
  gap 4px 6px

.db-view-sort-controls select
  width 100%
  min-width 0

.db-view-sort-row--date .db-view-sort-field
  grid-column 1 / -1

.db-view-sort-menu .db-view-sort-handle,
.db-view-sort-menu .db-view-sort-remove
  opacity 1
  margin-top 2px

.db-view-sort-menu .db-view-sort-handle
  cursor grab
  touch-action none

.db-view-sort-menu .db-view-sort-handle:active
  cursor grabbing

.db-view-sort-menu .db-view-sort-handle:disabled
  cursor default
  opacity .45

.db-view-sort-action
  display flex
  align-items center
  gap 8px
  min-height 28px

.db-view-sort-action svg
  width 14px
  height 14px
  flex none
  color var(--b3-theme-on-surface)

// 搜索框失焦且为空时移出布局；原生清空图标用按钮承载，支持键盘操作。
.db-view-search
  position relative
  flex 0 0 auto

.db-view-search[hidden],
.db-view-search-clear[hidden]
  display none

.db-view-search-input
  width 128px
  max-width 28vw
  padding-right 18px
  white-space nowrap
  overflow hidden

.db-view-search-clear
  align-self center
  display inline-grid
  place-items center
  border 0
  padding 0
  background transparent
  color var(--b3-theme-on-surface)

.db-view-search-clear svg
  width 14px
  height 14px

// 原生只读样式会隐藏管理视图入口；分享页单独呈现已发布视图的导航按钮。
.protyle-wysiwyg[data-readonly=true] .av .av__views > button.block__icon.av__views-switcher--all[data-type=av-switcher]
  display inline-flex
  gap 4px

.db-view-switcher
  position fixed
  inset auto
  margin 0
  box-sizing border-box
  width 290px
  max-width calc(100vw - 16px)
  max-height calc(100vh - 16px)
  overflow auto
  padding 8px

.db-view-switcher input.db-view-switcher-search
  width 100%
  box-sizing border-box
  margin-bottom 8px

.db-view-switcher-heading
  border-top 1px solid var(--b3-border-color)
  padding 8px 6px 3px

.db-view-switcher .db-view-switcher-item
  gap 8px

.db-view-switcher-item[hidden],
.db-view-switcher .db-view-filter-status[hidden]
  display none

.db-view-switcher-item svg
  width 14px
  height 14px
  flex none
  color var(--b3-theme-on-surface)
