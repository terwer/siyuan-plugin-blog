/*
 * 数据库外观完全由思源原生 base.css 提供。
 * 本文件只保留查看端本地筛选面板、空结果和未知类型回退的布局适配，
 * 不定义数据库标题、标签、工具栏、表格、卡片、看板或日历的视觉样式。
 */

.db-view-filter
  min-width 320px
  max-width calc(100vw - 16px)

.db-view-filter .db-view-filter-items
  display flex
  flex-direction column
  gap 8px
  padding 8px 12px

.db-view-filter .db-view-filter-field
  display flex
  align-items center
  gap 8px
  min-height 28px

.db-view-filter .db-view-filter-field > span
  flex 0 0 48px
  color var(--b3-theme-on-surface-light)
  font-size 12px

.db-view-filter .db-view-filter-field select,
.db-view-filter .db-view-filter-field input
  flex 1 1 auto
  min-width 0
  height 30px

.db-view-filter-actions
  display flex
  gap 6px
  padding-top 4px

.db-view-filter-status
  min-height 18px
  margin 0
  color var(--b3-theme-on-surface-light)
  font-size 12px

.db-view-filter-status:empty
  display none

.db-view-empty,
.db-view-unsupported
  margin 8px 0
  padding 16px
  color var(--b3-theme-on-surface-light)

@media (max-width: 640px)
  .db-view-filter
    min-width 0
    width calc(100vw - 16px)

  .db-view-filter .db-view-filter-field
    flex 1 1 100%
