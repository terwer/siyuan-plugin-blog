/*
 * 数据库外观完全由思源原生 base.css 提供。
 * 本文件只保留查看端本地筛选面板、空结果和未知类型回退的布局适配，
 * 不定义数据库标题、标签、工具栏、表格、卡片、看板或日历的视觉样式。
 */

.db-view-filter
  min-width 320px
  max-width calc(100vw - 16px)

.db-view-filter-status
  min-height 18px
  margin 0
  color var(--b3-theme-on-surface-light)
  font-size 12px

.db-view-filter-status:empty
  display none

.db-view-empty,
.db-view-unsupported
  margin 8px 0
  padding 16px
  color var(--b3-theme-on-surface-light)

@media (max-width: 640px)
  .db-view-filter
    min-width 0
    width calc(100vw - 16px)

.db-view-detail
  position fixed
  top 16px
  right 16px
  z-index 1000
  width 420px\n  max-width calc(100vw - 32px)
  max-height calc(100vh - 32px)
  overflow auto
  padding 16px
  background var(--b3-theme-background, #fff)
  border 1px solid var(--b3-border-color, #d9d9d9)
  border-radius 8px
  box-shadow 0 8px 28px rgba(0, 0, 0, .18)

.db-view-detail-header
  display flex
  align-items center
  justify-content space-between
  gap 12px
  padding-bottom 12px
  border-bottom 1px solid var(--b3-border-color, #d9d9d9)

.db-view-detail-close
  border 0
  background transparent
  color var(--b3-theme-on-surface, #333)
  font-size 22px
  cursor pointer

.db-view-detail-body
  display flex
  flex-direction column
  gap 12px
  padding-top 12px

.db-view-detail-field
  display grid
  grid-template-columns minmax(96px, 38%) 1fr
  gap 12px

.db-view-detail-label
  color var(--b3-theme-on-surface-light, #777)

.db-view-detail-value
  color var(--b3-theme-on-surface, #222)
  overflow-wrap anywhere

.db-view-ssr-placeholder
  display flex
  align-items center
  gap 12px
  margin 12px 0
  padding 14px 16px
  border 1px solid var(--b3-border-color, #d9d9d9)
  border-radius 8px
  background var(--b3-theme-surface-lighter, #f7f7f7)
  color var(--b3-theme-on-surface, #333)

.db-view-ssr-placeholder-icon
  display inline-flex
  align-items center
  justify-content center
  width 32px
  height 32px
  border-radius 6px
  background var(--b3-theme-primary-lightest, #eaf2ff)
  color var(--b3-theme-primary, #4285f4)
  font-size 22px
  line-height 1

.db-view-ssr-placeholder-content
  display flex
  flex-direction column
  gap 3px
  min-width 0

.db-view-ssr-placeholder-content strong
  font-size 13px

.db-view-ssr-placeholder-content span
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.db-view-ssr-placeholder-content small
  color var(--b3-theme-on-surface-light, #888)
  font-size 12px

.db-view-toast
  position fixed
  left 50%
  bottom 32px
  z-index 1100
  transform translateX(-50%)
  padding 8px 14px
  border-radius 6px
  background var(--b3-theme-on-surface, #333)
  color var(--b3-theme-background, #fff)
  font-size 13px
  box-shadow 0 4px 16px rgba(0, 0, 0, .18)

.db-view-toast--error
  background var(--b3-theme-error, #d93025)

// 思源宿主隐藏只读工具栏中的筛选入口；分享页筛选仅作用于内存快照。
.protyle-wysiwyg[data-readonly=true] .av .av__views > button.block__icon.av__readonly-filter[data-type=av-filter]
  display inline-flex

// 阅读筛选使用原生菜单控件；按视口约束浮层与分组内联布局。
.db-view-filter-menu,
.db-view-filter-picker
  position fixed
  inset auto
  margin 0
  box-sizing border-box
  max-width calc(100vw - 16px)
  max-height calc(100vh - 16px)
  overflow auto

.db-view-filter-menu
  z-index 1000
  width max-content
  min-width 360px
  padding 8px

.db-view-filter-picker
  z-index 1001
  min-width 150px
  padding 4px

.db-view-filter-heading
  position relative
  display grid
  place-items center
  min-height 36px
  border-bottom 1px solid var(--b3-border-color)

.db-view-filter-heading > button
  position absolute
  left 4px
  display inline-flex
  opacity 1

.db-view-filter-body
  padding-top 6px

.db-view-filter-rule
  display grid
  grid-template-columns 48px minmax(0, 1fr) 28px
  align-items start
  gap 8px
  padding 4px

.db-view-filter-rule > span
  line-height 30px
  text-align center
  color var(--b3-theme-on-surface)

.db-view-filter-controls
  display flex
  flex-wrap wrap
  align-items center
  gap 6px
  min-width 0

.db-view-filter-group
  flex 1 1 100%
  min-width 0
  padding 6px
  border 1px solid var(--b3-border-color)
  border-radius 6px
  background var(--b3-theme-surface)

.db-view-filter-select,
.db-view-filter-choice,
.db-view-filter-remove
  display inline-flex
  align-items center
  gap 6px

.db-view-filter-menu .db-view-filter-remove
  opacity 1

.db-view-filter-choice
  display flex
  text-align start
  min-height 30px

.db-view-filter-select,
.db-view-filter-value-input
  min-height 30px

.db-view-filter-select
  cursor pointer

.db-view-filter-value-input
  flex 1 1 120px
  width 155px
  box-sizing border-box

.db-view-filter-icon
  display inline-flex
  flex none
  color var(--b3-theme-on-surface)

.db-view-filter-icon svg
  width 14px
  height 14px

@media (max-width: 640px)
  .db-view-filter-menu
    min-width 0
    width calc(100vw - 16px)

  .db-view-filter-rule
    grid-template-columns 36px minmax(0, 1fr) 24px
    gap 4px

// 排序复用思源菜单与原生下拉；日期规则的端点与方向独占下一行。
.db-view-sort-menu
  position fixed
  inset auto
  margin 0
  box-sizing border-box
  width 290px
  max-width calc(100vw - 16px)
  max-height calc(100vh - 16px)
  overflow auto
  padding 8px

.db-view-sort-items
  padding-top 4px

.db-view-sort-row
  display grid
  grid-template-columns 22px minmax(0, 1fr) 22px
  align-items start
  gap 6px
  padding 4px
  border-radius 6px

.db-view-sort-row:hover,
.db-view-sort-row:focus-within
  background var(--b3-list-hover)

.db-view-sort-row[data-sort-drop=before]
  box-shadow inset 0 2px var(--b3-theme-primary)

.db-view-sort-row[data-sort-drop=after]
  box-shadow inset 0 -2px var(--b3-theme-primary)

.db-view-sort-controls
  display grid
  grid-template-columns minmax(0, 1fr) auto
  gap 4px 6px

.db-view-sort-controls select
  width 100%
  min-width 0

.db-view-sort-row--date .db-view-sort-field
  grid-column 1 / -1

.db-view-sort-menu .db-view-sort-handle,
.db-view-sort-menu .db-view-sort-remove
  opacity 1
  margin-top 2px

.db-view-sort-menu .db-view-sort-handle
  cursor grab
  touch-action none

.db-view-sort-menu .db-view-sort-handle:active
  cursor grabbing

.db-view-sort-menu .db-view-sort-handle:disabled
  cursor default
  opacity .45

.db-view-sort-action
  display flex
  align-items center
  gap 8px
  min-height 28px

.db-view-sort-action svg
  width 14px
  height 14px
  flex none
  color var(--b3-theme-on-surface)
