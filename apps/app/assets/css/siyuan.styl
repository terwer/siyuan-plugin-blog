/*
 * 正文样式以思源原生 app/base.css + 当前主题为准。
 * 本文件只处理只读查看所需的页面布局和编辑器 UI。
 */

/*
 * 分享页是阅读页面，不展示思源编辑器的灰色画布。
 * 使用主题背景变量，浅色/深色模式自动适配；不改其他原生正文样式。
 */
html body
  background-color var(--b3-theme-background)
  background-image none

/*
 * 左下角主题/偏好按钮的图标继承 footer 固定的 #bbb，
 * 浅色背景下几乎看不见。用主题文字色覆盖，浅色/深色自动适配。
 */
.footer .buttons .button
  color var(--textColor)

/*
 * 分享页的四类字体体系分别由独立的查看端变量控制：
 * 正文、代码、Emoji、数学。思源主题字体先渲染、查看端字体随后替换会造成字体跳变，
 * 所以四类都在 body 上定义，覆盖从 html 继承的思源主题字体变量，无需 !important。
 */
body
  --viewer-font-stack "Open Sans", "LXGW WenKai", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, "Fira Sans", "Droid Sans", "Helvetica Neue", "Microsoft YaHei", "PingFang SC", "Hiragino Sans GB", Arial, sans-serif
  --viewer-font-stack-code "Open Sans", "JetBrains Mono", "LXGW WenKai", "SFMono-Regular", Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace
  --viewer-font-stack-emoji "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", "Emojis Additional", "Emojis Reset", sans-serif
  --viewer-font-stack-math "KaTeX_Main", var(--viewer-font-stack)

  --b3-font-family var(--viewer-font-stack)
  --b3-font-family-base var(--viewer-font-stack)
  --b3-font-family-protyle var(--viewer-font-stack)
  --b3-font-family-code var(--viewer-font-stack-code)
  --b3-font-family-kbd var(--viewer-font-stack-code)
  --b3-font-family-emoji var(--viewer-font-stack-emoji)
  --b3-font-family-math var(--viewer-font-stack-math)
  --b3-font-family-graph var(--viewer-font-stack)
  --el-font-family var(--viewer-font-stack)

/*
 * 分享页使用对称阅读留白：桌面标题 16px 32px、正文 24px 32px；
 * 移动端随视口收缩。留白只作用于页面容器，字号、行高、颜色仍由思源原生样式决定。
 */
html body .protyle-title
  padding 16px 32px
  margin 0

html body .protyle-wysiwyg
  padding 24px 32px
  margin 0

.protyle--preview .protyle-title
  padding 14px 16px 10px

.protyle--preview .protyle-title__input
  font-size 22px
  line-height 1.35

.protyle--preview .protyle-wysiwyg
  padding 12px 16px 20px

@media (max-width: 768px)
  html body .protyle-title
    padding 14px clamp(8px, 2.8vw, 12px) 12px

  html body .protyle-title__input
    padding-left 0
    padding-right 0

  html body .protyle-wysiwyg
    padding 18px clamp(8px, 2.8vw, 12px)

/*
 * 普通链接保留思源原生 span 结构和下边框；悬停时下划线颜色跟随主题主色，
 * 让真实链接在浅色/深色下都有可感知的交互反馈。
 */
.protyle-wysiwyg [data-node-id] span[data-type~=a]:hover
  border-bottom-color var(--b3-theme-primary)

/* 只读分享页不展示块级操作按钮 */
.protyle-gutters,
.protyle-icons
  display none

/* 避免正文出现横向滚动条 */
.protyle-content
  overflow hidden
