# Private backend connection for SSR bootstrap; never hydrated into browser state.
NUXT_PROVIDER_INTERNAL_URL=http://127.0.0.1:8086
# Application prefix; the sharing client's reading address must include this prefix.
NUXT_APP_BASE_URL=/
# Optional AI configuration (private server environment).
NUXT_AI_BASE_URL=https://api.openai.com
NUXT_AI_API_KEY=
NUXT_AI_MODEL=
NUXT_PUBLIC_VIEWER_CAPABILITIES_AI_ASSISTANT=false
